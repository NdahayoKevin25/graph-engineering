{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "redirectAfterLogin": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^/(?:[A-Za-z0-9_-]+/?)*$",
      "default": "/"
    }
  }
}
