{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["entities"],
  "properties": {
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityName", "tableExportName", "sampleRows"],
        "properties": {
          "entityName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,47}$" },
          "tableExportName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}Table$" },
          "sampleRows": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object", "minProperties": 1, "maxProperties": 50 } }
        }
      }
    }
  }
}
