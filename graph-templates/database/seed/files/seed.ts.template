export async function seedDatabase(): Promise<void> {
  const pool = new Pool(operationDatabaseOptions('seed'));
  pool.on('error', () => { console.error('Seed connection failed.'); });
  try {
    await drizzle(pool).transaction(async (transaction) => {
      const lock = await transaction.execute(sql`SELECT pg_try_advisory_xact_lock(174824711, 1) AS locked`);
      if (lock.rows[0]?.locked !== true) throw new Error('A database operation is already active.');
{{SEED_INSERTS}}
    });
  } catch { throw new Error('Reviewed seed failed; transaction rolled back and fixture values are not exposed.'); }
  finally { await pool.end(); }
}

if (require.main === module) {
  seedDatabase().then(() => { console.log('Reviewed seed completed.'); }).catch(() => {
    console.error('Seed failed; transaction rolled back. Credentials, SQL, and fixture values are not logged.');
    process.exitCode = 1;
  });
}
