{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test.schema.json",
  "title": "Test Schema Artifact",
  "description": "Structured output of ai/testing-agent: which nodes have test coverage, of what kind, and current pass/fail state.",
  "type": "object",
  "required": ["$schema", "artifactType", "version", "metadata", "data"],
  "properties": {
    "$schema": { "type": "string" },
    "artifactType": { "const": "test.schema" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "metadata": { "$ref": "requirements.schema.json#/$defs/metadata" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suites"],
      "properties": {
        "framework": { "type": "string", "default": "vitest" },
        "suites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodeId", "kind", "file"],
            "properties": {
              "nodeId": { "type": "string", "description": "The graph node this suite covers" },
              "instanceId": { "type": "string", "minLength": 1, "description": "Specific architecture invocation covered; required to disambiguate repeated nodeId templates." },
              "kind": { "enum": ["unit", "integration", "api"] },
              "file": { "type": "string" },
              "status": { "enum": ["not-run", "passing", "failing"], "default": "not-run" },
              "lastRunAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "coverageGaps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Node ids in architecture.json with no corresponding suite — consumed by ai/validation-agent."
        }
      }
    }
  }
}
