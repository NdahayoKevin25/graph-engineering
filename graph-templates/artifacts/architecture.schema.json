{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture.schema.json",
  "title": "Architecture Artifact",
  "description": "Structured output of ai/architect-agent: the resolved graph of nodes this application will be composed from, plus stack choices.",
  "type": "object",
  "required": ["$schema", "artifactType", "version", "metadata", "data"],
  "properties": {
    "$schema": { "type": "string" },
    "artifactType": { "const": "architecture" },
    "version": { "type": "string", "pattern": "^[12]\\.\\d+\\.\\d+$" },
    "metadata": { "$ref": "requirements.schema.json#/$defs/metadata" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectName", "stack", "nodes"],
      "properties": {
        "projectName": { "type": "string" },
        "stack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "database", "storage"],
          "properties": {
            "backend": { "enum": ["express", "fastify", "nestjs"] },
            "frontend": { "enum": ["nextjs", "react", "none"] },
            "database": { "enum": ["neon-postgres", "postgres", "mysql"] },
            "storage": { "enum": ["aws-s3", "cloudflare-r2", "local", "none"] },
            "authentication": { "enum": ["jwt", "session", "oauth", "none"] },
            "authorization": { "enum": ["rbac", "none"] },
            "deployment": { "enum": ["docker", "serverless", "none"] }
          }
        },
        "nodes": {
          "type": "array",
          "description": "Ordered invocations. id identifies the registry template; instanceId uniquely identifies one invocation in artifact version 2.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "order"],
            "properties": {
              "id": { "type": "string", "description": "Dotted template id, e.g. backend.express.controller" },
              "instanceId": { "type": "string", "minLength": 1, "description": "Unique invocation identity, e.g. backend.service:Product; singleton invocations conventionally use id." },
              "bindings": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 }, "description": "Required or selected extends template id to the chosen upstream instanceId. Required when a dependency template has multiple invocations." },
              "order": { "type": "integer", "minimum": 0 },
              "inputs": { "type": "object" }
            }
          }
        },
        "edges": {
          "type": "array",
          "description": "Additional dependency edges: from dependent instanceId to prerequisite instanceId. Prerequisites run earlier.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "pattern": "^2\\." } } },
      "then": { "properties": { "data": { "properties": { "nodes": { "items": { "required": ["instanceId"] } } } } } },
      "else": { "properties": { "data": { "properties": { "nodes": { "items": { "not": { "anyOf": [{ "required": ["instanceId"] }, { "required": ["bindings"] }] } } } } } } }
    }
  ]
}
