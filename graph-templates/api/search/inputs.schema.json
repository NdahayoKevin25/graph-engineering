{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["entityName", "tableName", "searchFields"],
  "properties": {
    "entityName": { "type": "string", "maxLength": 48, "pattern": "^[A-Z][A-Za-z0-9]{0,47}$" },
    "tableName": { "type": "string", "maxLength": 40, "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "searchFields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 48, "pattern": "^[a-z][A-Za-z0-9]{0,47}$" }
    }
  }
}
